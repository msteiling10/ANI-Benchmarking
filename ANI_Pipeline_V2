        data_folder=outfile_for_fastq,
        output_folder=OUTPUT_FOLDER,
        subsamples=SUBSAMPLES,
        no_reads_in_subsample=dynamic_reads_target,
    )
    
    # Run Benchmarking Tools
    run_fast_ani(output_folder=OUTPUT_FOLDER, genomes_dir=outfile_for_genomes)
    run_pyani(output_folder=OUTPUT_FOLDER, genomes_dir=outfile_for_genomes)
    run_mash(output_folder=OUTPUT_FOLDER, genomes_dir=outfile_for_genomes)
    
    # Compile all tool outputs into a single CSV for downstream statistics
    compile_results_to_csv(output_csv="Lactobacillus_gasseri_ani_benchmark_summary.csv")
