def run_command(cmd_str_or_list):
    """Executes a command directly or wrapped inside 'conda run' if CONDA_ENV is set. This allows for easy access to tools"""
    if CONDA_ENV:
        if isinstance(cmd_str_or_list, list):
            cmd = ["conda", "run", "-n", CONDA_ENV] + cmd_str_or_list
            subprocess.run(cmd, check=True)
        else:
            cmd = f"conda run -n {CONDA_ENV} {cmd_str_or_list}"
            subprocess.run(cmd, shell=True, check=True)
    else:
        if isinstance(cmd_str_or_list, list):
            subprocess.run(cmd_str_or_list, check=True)
        else:
            subprocess.run(cmd_str_or_list, shell=True, check=True)


def count_reads(fastq_path): #this helps ensure we are only using paired end, FASTQ formatted data
    """Calculates total reads in a FASTQ file (4 lines per read)."""
    line_count = 0
    with open(fastq_path, "r") as f:
        for _ in f:
            line_count += 1
    return line_count // 4


def init_folders(output_folder, sample_no): #begin manking folders needed to run these processes 
    """Creates directory tree for subsamples, trimmed outputs, and assemblies."""
    ss_dir = os.path.join(output_folder, sample_no, "ss") #subsamples here
    trim_dir = os.path.join(output_folder, sample_no, "trim_ss") #trimmed data here
    assemble_dir = os.path.join(output_folder, sample_no, "assemble") #assembled data here 

    os.makedirs(ss_dir, exist_ok=True) #chunk that makes directories 
    os.makedirs(trim_dir, exist_ok=True)
    os.makedirs(assemble_dir, exist_ok=True)

    return ss_dir, trim_dir, assemble_dir #return the directories 


# --- PIPELINE STEP 1: DOWNLOAD GENOMES ---
#begins with downloading genomes from ncbi, this should pair smoothly with the .tsv
def download_via_ncbi_genome_download(acc_file, out_dir): #command uses ncbi-genome-download tool under refseq, using fasta to the output folder
    cmd = f"ncbi-genome-download --section refseq --assembly-accessions {acc_file} --formats fasta,gff --output-folder {out_dir} {NCBI_GENOME_SECTION}"
    print("=== Executing ncbi-genome-download ===") #comfort running message
    run_command(cmd) #run the command string from above
    
    # Automatically decompress gzipped fasta files (.fna.gz / .fasta.gz) so downstream tools can read them
    gz_files = glob.glob(os.path.join(out_dir, "**", "*.fna.gz"), recursive=True) + \
               glob.glob(os.path.join(out_dir, "**", "*.fasta.gz"), recursive=True)
               
    for gz_file in gz_files:
        output_file = gz_file[:-3]  # Removes '.gz' extension
        if not os.path.exists(output_file):
            print(f"Decompressing: {os.path.basename(gz_file)}")
            with gzip.open(gz_file, 'rb') as f_in, open(output_file, 'wb') as f_out:
                shutil.copyfileobj(f_in, f_out)
                
    print(f"Genomes saved in directory: {out_dir}\n") #comfort running message


def calculate_target_reads_for_20x(genomes_dir, sample_fastq_path):
    """
    Scans downloaded genome fasta files, calculates average genome length,
    and determines required reads per file for 20x coverage. 20x is recommended coverage based on Putonti Lab assessments 
    """
    print("=== Calculating 20x Coverage Target based on Downloaded Genomes ===") #comfort running message
    
    fasta_files = glob.glob(os.path.join(genomes_dir, "**", "*.fna"), recursive=True) + \
                  glob.glob(os.path.join(genomes_dir, "**", "*.fasta"), recursive=True) #double wildcard means it can look at nested directories, single gets sample name
    
    if not fasta_files:
        print("Warning: No genome FASTA files found.")
        return NO_READS_IN_SUBSAMPLE #defaults empty to basic parameters 

    genome_lengths = [] #take the genome lengths as a list 
    for fasta in fasta_files: 
        current_len = 0 #start at 0
        with open(fasta, "r") as f:
            for line in f:
                if not line.startswith(">"):
                    current_len += len(line.strip())
        if current_len > 0:
            genome_lengths.append(current_len) #append the length of the data 

    if not genome_lengths:
        return NO_READS_IN_SUBSAMPLE 

    avg_genome_length = sum(genome_lengths) / len(genome_lengths) #find the average length 
    
    read_lengths = [] 
    with open(sample_fastq_path, "r") as f:
        for i, line in enumerate(f):
            if i % 4 == 1: #length is divided by 4 due to formatting of fastq 
                read_lengths.append(len(line.strip()))
            if len(read_lengths) >= 100:
                break #stops at 100 for effieciency and to not blow up the server 
                
    avg_read_length = sum(read_lengths) / len(read_lengths) if read_lengths else 150 #find the average length of the reads 

    target_total_bases = avg_genome_length * 20 #find the 20x coverage 
    target_reads_per_file = int((target_total_bases / 2) / avg_read_length) #divided by 2 due to the paired end data

    print(f"  - Analyzed {len(genome_lengths)} reference genomes.") #comfort printing 
    print(f"  - Average Genome Length: {avg_genome_length:,.0f} bp")
    print(f"  - Calculated Reads per FASTQ file for 20x: {target_reads_per_file:,} reads\n")
    
    return target_reads_per_file #this is used for downstream sampling applicatons 


# --- PIPELINE STEP 2: FETCH FASTQS VIA SRA ---
def download_fastqs_from_biosamples(filtered_df, out_dir):
    os.makedirs(out_dir, exist_ok=True) #make a directory to hold fastqs 

    biosamples = filtered_df["Assembly BioSample Accession"].dropna().unique().tolist() #filtering the tsv
    assembly_accessions = filtered_df["Assembly Accession"].dropna().unique().tolist()
    
    queries = list(set(biosamples + assembly_accessions)) #make a list of queries 
    print(f"=== Fetching SRA Run IDs for {len(queries)} target identifiers ===") #print how many are found after quality control 

    srr_runs = set() 
    for q in queries:
        query_term = f'"{q}"'
        print(f"Searching SRA for: {q}...")
        try:
            handle = Entrez.esearch(db="sra", term=query_term, retmax=20) #use entrez e search to pull the sra
            record = Entrez.read(handle) #use the read function to get the data 
            handle.close() #because it is polite to do this 

            id_list = record.get("IdList", []) #get a list of the IDs from the records 
            print(f"  -> Found SRA internal IDs: {id_list}") #print what we have found 
            
            if id_list:
                sum_handle = Entrez.esummary(db="sra", id=",".join(id_list)) #this lets info be pulled without using the whole record 
                sum_bytes = sum_handle.read()
                sum_handle.close() 

                # Decode bytes to string so regex can parse it successfully
                sum_text = sum_bytes.decode('utf-8', errors='ignore')

                found_runs = re.findall(r'\b([SED]RR\d+)\b', sum_text) #type all the found runs 
                print(f"  -> Found Run accession(s): {found_runs}") #what data was sucessfully pulled 
                for r in found_runs:
                    srr_runs.add(r)
            time.sleep(0.3) #timeout if taking too long, this seems to be the polite time requested by NCBI
        except Exception as e:
            print(f"Error finding SRA run for {q}: {e}") #write error message 

    srr_list = list(srr_runs) #list of runs 
    if not srr_list:
        print("\n[WARNING]: No SRA run IDs were found for the queried identifiers.") #if there are no runs give the error message 
        return

    print(f"=== Executing fasterq-dump for {len(srr_list)} unique runs ===") #fasterq-dump pulls the actual genome, can be subbed with fastq-dump
    for srr in srr_list:
        print(f"Downloading FASTQ for {srr}...") #downloading the SRR message 
        cmd = f"fasterq-dump --split-files --outdir {out_dir} {srr}" #command that splits into _1 and _2 for genome reads in the output directory 
        run_command(cmd)
        
# --- PIPELINE STEP 3: SUBSAMPLE, TRIM, AND ASSEMBLE --- #actual processing for the genomes
def subsample_trim_assemble_paired_end(
    data_folder, output_folder, subsamples, no_reads_in_subsample
):
    all_fastqs = sorted(glob.glob(os.path.join(data_folder, "*.fastq"))) #for all the fastqs make a directory 
    if not all_fastqs:
        print(f"No FASTQ files found in {data_folder}!") #if folder empty error message 
        return
 
    sample_pairs = {} #data must be in pairs in the list 
    for filepath in all_fastqs: #for each filepath 
        filename = os.path.basename(filepath) #get filename
        base_name = filename.split(".")[0] #base name is id
        if base_name.endswith("_1"): #forward read name
            sample_id = base_name[:-2] #backward read name
            sample_pairs.setdefault(sample_id, {})["R1"] = filepath
        elif base_name.endswith("_2"):
            sample_id = base_name[:-2]
            sample_pairs.setdefault(sample_id, {})["R2"] = filepath

    valid_pairs = [] #pair have to have both reads...because its a pair
    for sample_id, reads in sample_pairs.items():
        if "R1" in reads and "R2" in reads:
            valid_pairs.append((sample_id, reads["R1"], reads["R2"]))

    print(f"=== Successfully validated {len(valid_pairs)} paired-end samples ===")

    for sample_no, fastq1_path, fastq2_path in valid_pairs: #makes all the folders 
        ss_dir, trim_dir, assemble_dir = init_folders(output_folder, sample_no) #make all the directories 
        no_reads_in_sample = count_reads(fastq1_path) #count the reads in the subsamples 
        reads_to_take = min(no_reads_in_subsample, no_reads_in_sample) #grab the smaller one

        random.seed(RANDOM_SEED) #random seed changes what part of the genome we grab as the subsample
        random_seeds = random.sample(range(0, no_reads_in_sample), min(subsamples, no_reads_in_sample)) 
 
        for index, seed in enumerate(random_seeds): #printing a statement that shows the subsampling worked 
            print(f"\n=== Sample {sample_no} | Subsample Run {index+1}/{len(random_seeds)} (Seed: {seed}) ===")
            
            ss_f1 = os.path.join(ss_dir, f"{sample_no}_1_ss{index}.fastq") #forward subsample
            ss_f2 = os.path.join(ss_dir, f"{sample_no}_2_ss{index}.fastq") #reverse subsample 

            run_command(f"seqtk sample -s{seed} {fastq1_path} {reads_to_take} > {ss_f1}") #run seqtk on each seed to actually get a subsample
            run_command(f"seqtk sample -s{seed} {fastq2_path} {reads_to_take} > {ss_f2}") #seeds MATCH

            trim_f1 = os.path.join(trim_dir, f"{sample_no}_1_ss{index}_trim.fastq") #this gets folders ready for the trimmed data
            trim_f2 = os.path.join(trim_dir, f"{sample_no}_2_ss{index}_trim.fastq")
            stats_file = os.path.join(trim_dir, f"{sample_no}_ss{index}_trim.stats") #holding stats 

            bbduk_cmd = [
                "bbduk.sh", "-Xmx1G", "overwrite=t",        #XMX limiting amount of data usage, overwrite files allowed
                f"in1={ss_f1}", f"in2={ss_f2}",            #infiles are the subsamples matching of 1 and 2
                f"out1={trim_f1}", f"out2={trim_f2}",        #force trims left and right for output files
                "qtrim=rl", "trimq=20", "ftl=15", "ftr=135",
                "maq=20", "maxns=0", f"stats={stats_file}", #quality standards and write stats 
                "statscolumns=5", f"threads={THREADS}",
            ]
            run_command(bbduk_cmd) #BBDUK actually does the trimming

            sample_assembly_out = os.path.join(assemble_dir, f"{sample_no}_ss{index}_assembly") #get the assembly file ready 
            spades_cmd = [
                "spades.py", "--only-assembler", "-t", THREADS, #use only the assembler on Spades with the trimmed subsamples passed in
                "-1", trim_f1, "-2", trim_f2, "-o", sample_assembly_out,
            ]
            run_command(spades_cmd) #run the command

    print("\nAll subsampling, trimming, and assembly operations complete!") #finished message!


# --- PIPELINE STEP 4: RUN FASTANI BENCHMARK ---
def run_fast_ani(output_folder, genomes_dir): 
    """
    Runs FastANI comparing all assembled contigs against the downloaded reference genomes.
    """
    print("=== Executing FastANI ===") #ANI needs a ref and query 
    
    # Locate all reference genomes (.fna or .fasta)
    ref_files = glob.glob(os.path.join(genomes_dir, "**", "*.fna"), recursive=True) + \
                glob.glob(os.path.join(genomes_dir, "**", "*.fasta"), recursive=True)
    
    if not ref_files:
        print("[WARNING]: No reference genomes found for FastANI.") #if there is no refrence query return error 
        return

    # Create a text file containing paths to all reference genomes (required by FastANI --refList)
    ref_list_path = "reference_genomes_list.txt" #text list 
    with open(ref_list_path, "w") as f:
        for ref in ref_files:
            f.write(f"{ref}\n") #write each name on a seperate line 

    # Locate all assembled contigs from SPAdes outputs 
    contig_files = glob.glob(os.path.join(output_folder, "**", "contigs.fasta"), recursive=True)
    
    if not contig_files:
        print("[WARNING]: No assembled contigs found to run FastANI against.") #error message 
        return

    os.makedirs("fastani_results", exist_ok=True) #make an output directory 

    for query_contig in contig_files:
        # Extract sample name from path for clean output naming
        path_parts = query_contig.split(os.sep)
        sample_name = path_parts[-3] # Adjust based on your folder structure: results/SAMPLE/assemble/...
        subsample_id = path_parts[-2].replace("_assembly", "")
        
        output_file = os.path.join("fastani_results", f"{sample_name}_{subsample_id}_fastani.txt")
        
        fastani_cmd = [ #this is the actual command that runs FastANI, there is a query and a reflist 
            "fastANI",
            "--query", query_contig,
            "--refList", ref_list_path,
            "--output", output_file,
            "--threads", THREADS
        ]
        
        print(f"Running FastANI for {sample_name} ({subsample_id})...") #running each sample message 
        try:
            run_command(fastani_cmd)
            print(f"  -> Saved output to {output_file}")
        except Exception as e:
            print(f"Error running FastANI for {query_contig}: {e}")
            
            
# --- PIPELINE STEP 5: RUN PYANI ---
def run_pyani(output_folder, genomes_dir):
    """
    Runs PyANI by staging reference genomes and query contigs together 
    into a common directory for all-against-all comparison.
    """
    print("=== Executing PyANI ===")
    pyani_input_dir = "pyani_input_staging"
    pyani_output_dir = os.path.join("pyani_results", "anim_out")
    
    # 1. Clean or create staging and output directories
    if os.path.exists(pyani_output_dir):
        import shutil
        shutil.rmtree(pyani_output_dir)
    os.makedirs(pyani_output_dir, exist_ok=True)
    
    if os.path.exists(pyani_input_dir):
        import shutil
        shutil.rmtree(pyani_input_dir)
    os.makedirs(pyani_input_dir, exist_ok=True)

    # 2. Copy reference genomes into staging
    ref_files = glob.glob(os.path.join(genomes_dir, "**", "*.fna"), recursive=True) + \
                glob.glob(os.path.join(genomes_dir, "**", "*.fasta"), recursive=True)
    for ref in ref_files:
        dest = os.path.join(pyani_input_dir, os.path.basename(ref))
        if not os.path.exists(dest):
            shutil.copy(ref, dest)

    # 3. Copy query contigs into staging (renaming them to avoid name collisions)
    contig_files = glob.glob(os.path.join(output_folder, "**", "contigs.fasta"), recursive=True)
    if not contig_files:
        print("[WARNING]: No assembled contigs found for PyANI.")
        return

    for query_contig in contig_files:
        path_parts = query_contig.split(os.sep)
        sample_name = path_parts[-3]
        subsample_id = path_parts[-2].replace("_assembly", "")
        unique_contig_name = f"{sample_name}_{subsample_id}_contigs.fasta"
        dest = os.path.join(pyani_input_dir, unique_contig_name)
        shutil.copy(query_contig, dest)

    # 4. Run PyANI anim command
    pyani_command = [
        "pyani", "anim",
        "-i", pyani_input_dir,
        "-o", pyani_output_dir,
        "--graphics"
    ]
    
    print("Running PyANI...")
    try:
        run_command(pyani_command)
        print("  -> PyANI execution completed successfully.")
    except Exception as e:
        print(f"Error running PyANI: {e}")

# --- PIPELINE STEP 6: RUN MASH ---
def run_mash(output_folder, genomes_dir):
    """
    Runs Mash by sketching reference genomes and calculating distances against query contigs.
    """
    print("=== Executing Mash ===")
    os.makedirs("mash_results", exist_ok=True)
    
    ref_files = glob.glob(os.path.join(genomes_dir, "**", "*.fna"), recursive=True) + \
                glob.glob(os.path.join(genomes_dir, "**", "*.fasta"), recursive=True)
    
    if not ref_files:
        print("[WARNING]: No reference genomes found for Mash.")
        return

    # Step 1: Create a combined reference sketch
    sketch_path = "mash_references.msh"
    sketch_cmd = ["mash", "sketch", "-o", sketch_path] + ref_files
    print("Sketching reference genomes for Mash...")
    try:
        run_command(sketch_cmd)
    except Exception as e:
        print(f"Error creating Mash sketch: {e}")
        return

    contig_files = glob.glob(os.path.join(output_folder, "**", "contigs.fasta"), recursive=True)
    
    # Step 2: Compute Mash distance for each query against the reference sketch
    for query_contig in contig_files:
        path_parts = query_contig.split(os.sep)
        sample_name = path_parts[-3]
        subsample_id = path_parts[-2].replace("_assembly", "")
        
        mash_out_file = os.path.join("mash_results", f"{sample_name}_{subsample_id}_mash.tab")
        
        mash_dist_cmd = [
            "mash", "dist",
            "-t",              # Tabular output
            sketch_path,
            query_contig
        ]
        
        print(f"Running Mash dist for {sample_name} ({subsample_id})...")
        try:
            with open(mash_out_file, "w") as outfile:
                subprocess.run(mash_dist_cmd, stdout=outfile, check=True)
            print(f"  -> Saved Mash output to {mash_out_file}")
        except Exception as e:
            print(f"Error running Mash for {query_contig}: {e}")


# --- PIPELINE STEP 7: COMPILE ALL RESULTS INTO A SINGLE CSV ---
def compile_results_to_csv(output_csv="ani_benchmark_summary.csv"):
    """
    Parses FastANI, Mash, and PyANI output files and compiles them into a unified CSV for stats.
    """
    print("=== Compiling Results into CSV ===")
    records = []

    # 1. Parse FastANI results
    fastani_files = glob.glob(os.path.join("fastani_results", "*_fastani.txt"))
    for file in fastani_files:
        filename_base = os.path.basename(file).replace("_fastani.txt", "")
        parts = filename_base.split("_")
        sample_name = parts[0]
        subsample_id = parts[1] if len(parts) > 1 else "unknown"

        if os.path.getsize(file) > 0:
            df_fastani = pd.read_csv(file, sep="\t", header=None, 
                                     names=["query", "reference", "ani", "aligned_fraction_query", "aligned_fraction_ref"])
            for _, row in df_fastani.iterrows():
                records.append({
                    "sample": sample_name,
                    "subsample": subsample_id,
                    "tool": "FastANI",
                    "reference": os.path.basename(str(row["reference"])),
                    "ani": float(row["ani"]),
                    "metric_extra": float(row["aligned_fraction_query"])
                })

    # 2. Parse Mash results (Fixed with header=None)
    mash_files = glob.glob(os.path.join("mash_results", "*_mash.tab"))
    for file in mash_files:
        filename_base = os.path.basename(file).replace("_mash.tab", "")
        parts = filename_base.split("_")
        sample_name = parts[0]
        subsample_id = parts[1] if len(parts) > 1 else "unknown"

        if os.path.getsize(file) > 0:
            df_mash = pd.read_csv(file, sep="\t", header=None,
                                  names=["reference", "query", "mash_distance", "p_value", "matching_hashes"])
            for _, row in df_mash.iterrows():
                mash_dist = float(row["mash_distance"])
                approx_ani = (1.0 - mash_dist) * 100
                records.append({
                    "sample": sample_name,
                    "subsample": subsample_id,
                    "tool": "Mash",
                    "reference": os.path.basename(str(row["reference"])),
                    "ani": approx_ani,
                    "metric_extra": mash_dist
                })

    # 3. Parse PyANI results (ANIm percentage identity matrix)
    pyani_files = glob.glob(os.path.join("pyani_results", "anim_out", "*percentage_identity.tab"))
    for file in pyani_files:
        if os.path.getsize(file) > 0:
            df_pyani = pd.read_csv(file, sep="\t", index_col=0)
            # PyANI outputs a square matrix: rows are queries/references, columns are references
            for query_id in df_pyani.index:
                # Try to parse sample and subsample from query name if applicable
                q_parts = str(query_id).split("_")
                sample_name = q_parts[0]
                subsample_id = q_parts[1] if len(q_parts) > 1 else "unknown"
                
                for ref_id in df_pyani.columns:
                    identity = df_pyani.loc[query_id, ref_id]
                    if pd.notna(identity):
                        records.append({
                            "sample": sample_name,
                            "subsample": subsample_id,
                            "tool": "PyANI",
                            "reference": os.path.basename(str(ref_id)),
                            "ani": float(identity) * 100,  # PyANI outputs fraction (e.g. 0.99), convert to %
                            "metric_extra": float(identity)
                        })

    # Convert to DataFrame and save
    if records:
        summary_df = pd.DataFrame(records)
        summary_df.to_csv(output_csv, index=False)
        print(f"[SUCCESS]: Compiled benchmark statistics saved to {output_csv}")
    else:
        print("[WARNING]: No benchmark results found to compile.")
        

