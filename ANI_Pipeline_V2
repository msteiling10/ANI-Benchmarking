if __name__ == "__main__":
    print("=== Pipeline Started ===")
    df = pd.read_csv(infile, sep="\t")

    # 1. Filter by contamination threshold and sequencing technology
    df_filtered = df[
        (df["CheckM contamination"] <= contamination_threshold) &
        (df["Assembly Sequencing Tech"] == sequencing_tech)
    ]

    # 2. Sort by CheckM completeness in descending order and take top 10
    df_filtered = df_filtered.sort_values(by="CheckM completeness", ascending=False)
    
    max_samples = 10
    df_filtered = df_filtered.head(max_samples)
    
    print(f"Taking top {len(df_filtered)} samples based on highest CheckM completeness.")

    accession_file = f"{organism}_download_accessions.txt"
    df_filtered["Assembly Accession"].to_csv(accession_file, index=False, header=False)

    # Executions
    download_via_ncbi_genome_download(accession_file, out_dir=outfile_for_genomes)
    download_fastqs_from_biosamples(df_filtered, out_dir=outfile_for_fastq)

    sample_fastqs = glob.glob(os.path.join(outfile_for_fastq, "*.fastq"))
    dynamic_reads_target = NO_READS_IN_SUBSAMPLE
    if sample_fastqs:
        dynamic_reads_target = calculate_target_reads_for_20x(outfile_for_genomes, sample_fastqs[0])

    subsample_trim_assemble_paired_end(
        data_folder=outfile_for_fastq,
        output_folder=OUTPUT_FOLDER,
        subsamples=SUBSAMPLES,
        no_reads_in_subsample=dynamic_reads_target,
    )
    
    # Run FastANI benchmark on the assembled outputs (properly aligned)
    run_fast_ani(output_folder=OUTPUT_FOLDER, genomes_dir=outfile_for_genomes)
